# URL base do backend (sem /api no final).
# Em produção (Vercel): https://<projeto>.railway.app
# Em dev local: deixe em branco — o código usa http://localhost:4000/api como fallback.
NEXT_PUBLIC_API_URL=

# Número do WhatsApp comercial (com DDI, só dígitos) — usado nos botões de contato
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999

# URL pública do site — usada em SEO (sitemap, robots, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
